+type budgetConcurrentTrial struct {
+	reader    *Reader
+	reject    bool
+	completed chan error
+}
+
+func (s budgetConcurrentTrial) run() {
+	var limit uint64 = 1 << 30
+	if s.reject {
+		limit = 0
+	}
+	var budget ReadBudget = NewReadBudget(context.Background(), limit, maximumStoredString)
+	var length uint64 = s.reader.Len()
+	var index uint64 = 0
+	for index = 0; index < length; index++ {
+		var row catalog.Row = catalog.Row{}
+		var exists bool = false
+		var err error = nil
+		row, exists, err = s.reader.RowBounded(uint32(index), &budget)
+		if s.reject {
+			if !errors.Is(err, ErrReadBudget) || exists || row != (catalog.Row{}) || budget.UsedBytes() != 0 {
+				s.completed <- errors.New("independent exhausted budget changed")
+				return
+			}
+		} else {
+			if err != nil || !exists {
+				s.completed <- errors.New("independent admitted budget failed")
+				return
+			}
+			var expected catalog.Row = catalog.Row{}
+			expected, exists, err = s.reader.Row(uint32(index))
+			if err != nil || !exists || expected != row {
+				s.completed <- errors.New("legacy row differs")
+				return
+			}
+			var record catalog.Record = catalog.Record{}
+			var want catalog.Record = catalog.Record{}
+			record, exists, err = s.reader.RecordBounded(uint32(index), &budget)
+			if err != nil || !exists {
+				s.completed <- errors.New("bounded record failed")
+				return
+			}
+			want, exists, err = s.reader.Record(uint32(index))
+			if err != nil || !exists || want != record {
+				s.completed <- errors.New("legacy record differs")
+				return
+			}
+		}
+	}
+	s.completed <- nil
+}
