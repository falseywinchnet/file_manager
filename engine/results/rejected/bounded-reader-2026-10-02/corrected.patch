+package generation
+
+import (
+	"context"
+	"errors"
+
+	"filemanager/engine/internal/catalog"
+)
+
+var ErrReadBudget error = errors.New("generation logical read budget exhausted")
+var ErrStringBudget error = errors.New("generation stored string exceeds caller limit")
+var ErrInvalidReadBudget error = errors.New("generation read budget requires context and explicit owner")
+
+// ReadBudget belongs to one sequential query/page owner. Do not copy after use
+// or share it concurrently. Independent budgets may borrow the same checked
+// Reader. Context is retained for this budget's lifetime; Reader never retains
+// the budget. The zero value is invalid. Construct a fresh budget to start over.
+//
+// UsedBytes charges logical requested bytes, including cache hits, before the
+// read (and before string allocation). An admitted read stays fully charged on
+// I/O failure or cancellation. Rejected reservations charge nothing. The first
+// error is terminal; later calls do no work. This is not physical I/O, output
+// encoding, total allocation, or peak scratch accounting.
+type ReadBudget struct {
+	context       context.Context
+	remaining     uint64
+	maximumString uint64
+	used          uint64
+	terminal      error
+}
+
+func NewReadBudget(ctx context.Context, logicalBytes uint64, maximumStringBytes uint64) ReadBudget {
+	var result ReadBudget = ReadBudget{context: ctx, remaining: logicalBytes, maximumString: maximumStringBytes}
+	if ctx == nil {
+		result.terminal = ErrInvalidReadBudget
+	}
+	return result
+}
+
+func (b *ReadBudget) UsedBytes() uint64 { return b.used }
+
+func (b *ReadBudget) fail(err error) error {
+	if b == nil {
+		return err
+	}
+	if b.terminal == nil {
+		b.terminal = err
+	}
+	return b.terminal
+}
+
+// Nil is reserved for the internal legacy access path, never RowBounded callers.
+func (b *ReadBudget) check() error {
+	if b == nil {
+		return nil
+	}
+	if b.terminal != nil {
+		return b.terminal
+	}
+	if b.context == nil {
+		b.terminal = ErrInvalidReadBudget
+		return b.terminal
+	}
+	b.terminal = b.context.Err()
+	return b.terminal
+}
+
+func (b *ReadBudget) reserve(count uint64, storedString bool) error {
+	var err error = b.check()
+	if err != nil || b == nil {
+		return err
+	}
+	if storedString && count > b.maximumString {
+		b.terminal = ErrStringBudget
+		return b.terminal
+	}
+	if count > b.remaining {
+		b.terminal = ErrReadBudget
+		return b.terminal
+	}
+	b.remaining -= count
+	b.used += count
+	return nil
+}
+
+// RowBounded shares the legacy decoder. Reader must already be checked and
+// remain open/immutable throughout the borrow, as for existing exact consumers.
+// Every error returns an empty row and false; earlier budget charges persist.
+func (r *Reader) RowBounded(ordinal uint32, budget *ReadBudget) (catalog.Row, bool, error) {
+	if budget == nil {
+		return catalog.Row{}, false, ErrInvalidReadBudget
+	}
+	var err error = budget.check()
+	if err != nil {
+		return catalog.Row{}, false, err
+	}
+	var access readerAccess = readerAccess{Reader: r, budget: budget}
+	var row catalog.Row = catalog.Row{}
+	var exists bool = false
+	row, exists, err = access.Row(ordinal)
+	if err == nil {
+		err = budget.check()
+	}
+	if err != nil {
+		err = budget.fail(err)
+		return catalog.Row{}, false, err
+	}
+	return row, exists, nil
+}
+
+// RecordBounded has the same terminal and ownership rules as RowBounded.
+// Returned strings are owned by the result, not borrowed cache slices.
+func (r *Reader) RecordBounded(ordinal uint32, budget *ReadBudget) (catalog.Record, bool, error) {
+	if budget == nil {
+		return catalog.Record{}, false, ErrInvalidReadBudget
+	}
+	var err error = budget.check()
+	if err != nil {
+		return catalog.Record{}, false, err
+	}
+	if uint64(ordinal) >= r.header.bindingCount {
+		return catalog.Record{}, false, nil
+	}
+	var access readerAccess = readerAccess{Reader: r, budget: budget}
+	var record catalog.Record = catalog.Record{}
+	record, err = access.recordAt(ordinal)
+	if err == nil {
+		err = budget.check()
+	}
+	if err != nil {
+		err = budget.fail(err)
+		return catalog.Record{}, false, err
+	}
+	return record, true, nil
+}
