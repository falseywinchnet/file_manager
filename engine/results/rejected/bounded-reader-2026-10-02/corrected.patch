+	"filemanager/engine/internal/workload"
+)
+
+// Probe borrows the real segment; it does not close it. Installed only before
+// any query and never changed while concurrent readers are running.
+type budgetReadProbe struct {
+	input   io.ReaderAt
+	calls   int
+	cancel  context.CancelFunc
+	failure error
+}
+
+func (p *budgetReadProbe) ReadAt(output []byte, offset int64) (int, error) {
+	p.calls++
+	if p.failure != nil {
+		return 0, p.failure
+	}
+	var count int = 0
+	var err error = nil
+	count, err = p.input.ReadAt(output, offset)
+	if p.cancel != nil {
+		p.cancel()
+	}
+	return count, err
+}
+
+func budgetFixture(t *testing.T, corpus workload.Corpus) *Reader {
+	t.Helper()
+	var root api.RootSpec = api.RootSpec{ID: "budget-fixture", Path: filepath.Join(t.TempDir(), "logical")}
+	var shard *catalog.Shard = nil
+	var err error = nil
+	shard, err = corpus.ReferenceShard(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var path string = filepath.Join(t.TempDir(), "checked.seg")
+	var metadata Metadata = Metadata{}
+	metadata, err = Write(path, 7, shard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reader *Reader = nil
+	reader, err = Open(path, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = reader.Check(metadata.SegmentDigest)
+	if err != nil {
+		reader.Close()
+		t.Fatal(err)
+	}
+	return reader
+}
+
+func TestReadBudgetExactBoundariesAndCache(t *testing.T) {
+	var reader *Reader = budgetFixture(t, workload.CorrectnessV1())
+	defer reader.Close()
+	var probe budgetReadProbe = budgetReadProbe{input: reader.file}
+	reader.cache.file = &probe
+	var budget ReadBudget = NewReadBudget(context.Background(), bindingRecordSize-1, maximumStoredString)
+	var row catalog.Row = catalog.Row{}
+	var exists bool = false
+	var err error = nil
+	row, exists, err = reader.RowBounded(0, &budget)
+	if !errors.Is(err, ErrReadBudget) || exists || row != (catalog.Row{}) || budget.UsedBytes() != 0 || probe.calls != 0 || reader.CacheBytes() != 0 {
+		t.Fatal("reservation exhaustion performed work or returned partial row", row, budget, probe.calls, err)
+	}
+	// First failure is terminal even when a subsequent call needs fewer bytes.
+	_, _, err = reader.RowBounded(uint32(reader.Len()), &budget)
+	if !errors.Is(err, ErrReadBudget) || probe.calls != 0 {
+		t.Fatal("terminal state was cleared", err)
+	}
+	budget = NewReadBudget(context.Background(), bindingRecordSize, maximumStoredString)
+	row, exists, err = reader.RowBounded(0, &budget)
+	if !errors.Is(err, ErrReadBudget) || exists || row != (catalog.Row{}) || budget.UsedBytes() != bindingRecordSize || probe.calls != 1 {
+		t.Fatal("exact binding allowance did not stop before object", budget, probe.calls, err)
+	}
+	// Legacy control independently supplies all decoded fields and expected cost.
+	var expected catalog.Row = catalog.Row{}
+	expected, exists, err = reader.Row(0)
+	if err != nil || !exists {
+		t.Fatal(err)
+	}
+	var cost uint64 = bindingRecordSize + 2*objectRecordSize + pathRecordSize + uint64(len(expected.Name)) + uint64(len(filepath.ToSlash(expected.RelativePath)))
+	var before int = probe.calls
+	budget = NewReadBudget(context.Background(), cost, maximumStoredString)
+	row, exists, err = reader.RowBounded(0, &budget)
+	if err != nil || !exists || row != expected || budget.UsedBytes() != cost || probe.calls != before {
+		t.Fatal("warm exact boundary/cost mismatch", budget, probe.calls, before, err)
+	}
+	// One byte less rejects the final string reservation without partial output.
+	budget = NewReadBudget(context.Background(), cost-1, maximumStoredString)
+	row, exists, err = reader.RowBounded(0, &budget)
+	var beforePath uint64 = cost - uint64(len(filepath.ToSlash(expected.RelativePath)))
+	if !errors.Is(err, ErrReadBudget) || exists || row != (catalog.Row{}) || budget.UsedBytes() != beforePath || probe.calls != before {
+		t.Fatal("final string boundary failed", budget, err)
+	}
+	// Reopen cold to demonstrate cache warmth cannot reduce the logical charge.
+	var cold *Reader = nil
+	cold, err = Open(reader.file.Name(), reader.root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cold.Close()
+	err = cold.Check(reader.Metadata().SegmentDigest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	budget = NewReadBudget(context.Background(), cost, maximumStoredString)
+	row, exists, err = cold.RowBounded(0, &budget)
+	if err != nil || !exists || row != expected || budget.UsedBytes() != cost {
+		t.Fatal("cold cost mismatch", err, budget)
+	}
+}
