+// readerAccess borrows Reader and optional caller-owned state for one call.
+// A nil budget is the existing unbudgeted path. Decoder logic is shared.
+type readerAccess struct {
+	*Reader
+	budget *ReadBudget
+}
+
+func (r *readerAccess) Row(ordinal uint32) (catalog.Row, bool, error) {
+	if uint64(ordinal) >= r.header.bindingCount {
+		return catalog.Row{}, false, nil
+	}
+	var binding storedBinding = storedBinding{}
+	var err error = nil
+	binding, err = r.bindingAt(ordinal)
+	if err != nil {
+		return catalog.Row{}, false, err
+	}
+	var object catalog.Object = catalog.Object{}
+	object, err = r.objectAt(binding.object)
+	if err != nil {
+		return catalog.Row{}, false, err
+	}
+	var parent catalog.Object = catalog.Object{}
+	parent, err = r.objectAt(binding.parent)
+	if err != nil {
+		return catalog.Row{}, false, err
+	}
+	var name string = ""
+	name, err = r.readString(componentNames, binding.nameOffset, binding.nameLength)
+	if err != nil {
+		return catalog.Row{}, false, err
+	}
+	var path string = ""
+	var pathOrdinal uint32 = 0
+	path, pathOrdinal, err = r.pathAt(uint64(ordinal))
+	if err != nil {
+		return catalog.Row{}, false, err
+	}
+	if pathOrdinal != ordinal {
+		return catalog.Row{}, false, errors.New("path index does not match binding ordinal")
+	}
+	var result catalog.Row = catalog.Row{
+		RelativePath: filepath.FromSlash(path), Name: name, Kind: object.Kind, Size: object.Size,
+		Mode: object.Mode, ModifiedUnixNano: object.ModifiedUnixNano, Identity: object.Identity,
+		Parent: parent.Identity,
+	}
+	return result, true, nil
+}
+
+func (r *readerAccess) recordAt(ordinal uint32) (catalog.Record, error) {
+	var binding storedBinding = storedBinding{}
+	var err error = nil
+	binding, err = r.bindingAt(ordinal)
+	if err != nil {
+		return catalog.Record{}, err
+	}
+	var object catalog.Object = catalog.Object{}
+	object, err = r.objectAt(binding.object)
+	if err != nil {
+		return catalog.Record{}, err
+	}
+	var name string = ""
+	name, err = r.readString(componentNames, binding.nameOffset, binding.nameLength)
+	if err != nil {
+		return catalog.Record{}, err
+	}
+	var path string = ""
+	var pathOrdinal uint32 = 0
+	path, pathOrdinal, err = r.pathAt(uint64(ordinal))
+	if err != nil {
+		return catalog.Record{}, err
+	}
+	if pathOrdinal != ordinal {
+		return catalog.Record{}, errors.New("path index does not match binding ordinal")
+	}
+	var result catalog.Record = catalog.Record{
+		Root: r.root.ID, Path: filepath.Join(r.root.Path, filepath.FromSlash(path)), Name: name,
+		Kind: object.Kind, Size: object.Size, Mode: object.Mode,
+		ModifiedUnixNano: object.ModifiedUnixNano, Identity: object.Identity,
+	}
+	return result, nil
+}
+
+func (r *readerAccess) bindingAt(ordinal uint32) (storedBinding, error) {
+	if uint64(ordinal) >= r.header.bindingCount {
+		return storedBinding{}, errors.New("binding ordinal outside segment")
+	}
+	var descriptor descriptor = r.header.descriptors[componentBindings-1]
+	var encoded [bindingRecordSize]byte = [bindingRecordSize]byte{}
+	var err error = r.readAt(encoded[:], descriptor.offset+uint64(ordinal)*bindingRecordSize)
+	if err != nil {
+		return storedBinding{}, fmt.Errorf("read binding %d: %w", ordinal, err)
+	}
+	if hasNonzero(encoded[20:24]) {
+		return storedBinding{}, errors.New("binding reserved bytes are nonzero")
+	}
+	var result storedBinding = storedBinding{
+		object: binary.LittleEndian.Uint32(encoded[0:4]), parent: binary.LittleEndian.Uint32(encoded[4:8]),
+		nameOffset: binary.LittleEndian.Uint64(encoded[8:16]),
+		nameLength: uint64(binary.LittleEndian.Uint32(encoded[16:20])),
+	}
+	if uint64(result.object) >= r.header.objectCount || uint64(result.parent) >= r.header.objectCount {
+		return storedBinding{}, errors.New("binding references an object outside the segment")
+	}
+	return result, nil
+}
+
+func (r *readerAccess) objectAt(ordinal uint32) (catalog.Object, error) {
+	if uint64(ordinal) >= r.header.objectCount {
+		return catalog.Object{}, errors.New("object ordinal outside segment")
+	}
+	var descriptor descriptor = r.header.descriptors[componentObjects-1]
+	var encoded [objectRecordSize]byte = [objectRecordSize]byte{}
+	var err error = r.readAt(encoded[:], descriptor.offset+uint64(ordinal)*objectRecordSize)
+	if err != nil {
+		return catalog.Object{}, fmt.Errorf("read object %d: %w", ordinal, err)
+	}
+	var object catalog.Object = catalog.Object{}
+	object, err = decodeObject(encoded[:])
+	return object, err
+}
+
+func (r *readerAccess) pathAt(index uint64) (string, uint32, error) {
+	if index >= r.header.bindingCount {
+		return "", 0, errors.New("path index outside segment")
+	}
+	var descriptor descriptor = r.header.descriptors[componentPaths-1]
+	var encoded [pathRecordSize]byte = [pathRecordSize]byte{}
+	var err error = r.readAt(encoded[:], descriptor.offset+index*pathRecordSize)
+	if err != nil {
+		return "", 0, fmt.Errorf("read path index %d: %w", index, err)
+	}
+	var offset uint64 = binary.LittleEndian.Uint64(encoded[0:8])
+	var length uint64 = uint64(binary.LittleEndian.Uint32(encoded[8:12]))
+	var ordinal uint32 = binary.LittleEndian.Uint32(encoded[12:16])
+	var tableLength uint64 = r.header.bindingCount * pathRecordSize
+	if tableLength > descriptor.length || offset > descriptor.length-tableLength {
+		return "", 0, errors.New("stored path offset lies outside its component")
+	}
+	var value string = ""
+	value, err = r.readBoundedString(descriptor, tableLength+offset, length)
+	return value, ordinal, err
+}
+
+func (r *readerAccess) readString(id componentID, offset, length uint64) (string, error) {
+	var value string = ""
+	var err error = nil
+	value, err = r.readBoundedString(r.header.descriptors[id-1], offset, length)
+	return value, err
+}
+
+func (r *readerAccess) readBoundedString(descriptor descriptor, offset, length uint64) (string, error) {
+	if length > maximumStoredString || offset > descriptor.length || length > descriptor.length-offset {
+		return "", errors.New("stored string lies outside its component")
+	}
+	var err error = nil
+	if r.budget != nil {
+		err = r.budget.reserve(length, true)
+		if err != nil {
+			return "", err
+		}
+	}
+	var value []byte = make([]byte, int(length))
+	if length != 0 {
+		if r.budget == nil {
+			err = r.cache.readAt(value, descriptor.offset+offset)
+		} else {
+			err = r.cache.readAtControlled(value, descriptor.offset+offset, r.budget)
+		}
+		if err != nil {
+			return "", fmt.Errorf("read stored string: %w", err)
+		}
+	}
+	if r.budget != nil {
+		err = r.budget.check()
+		if err != nil {
+			return "", err
+		}
+	}
+	var result string = string(value)
+	return result, nil
+}
+
+// Fixed records reserve logical bytes before any cache access. Strings reserve
+// separately before their allocation, then use the same controlled cache path.
+func (r *readerAccess) readAt(output []byte, offset uint64) error {
+	if r.budget == nil {
+		var legacyError error = r.cache.readAt(output, offset)
+		return legacyError
+	}
+	var err error = r.budget.reserve(uint64(len(output)), false)
+	if err != nil {
+		return err
+	}
+	err = r.cache.readAtControlled(output, offset, r.budget)
+	return err
+}
