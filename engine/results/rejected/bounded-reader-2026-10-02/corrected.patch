+func TestReadBudgetCorruptionIsTerminal(t *testing.T) {
+	var reader *Reader = budgetFixture(t, workload.CorrectnessV1())
+	defer reader.Close()
+	var expected catalog.Row = catalog.Row{}
+	var exists bool = false
+	var err error = nil
+	expected, exists, err = reader.Row(0)
+	if err != nil || !exists {
+		t.Fatal(err)
+	}
+	// Inject only into this test's warmed private cache after integrity checking.
+	// A near-maximum path offset used to wrap when added to the path table size.
+	var offset uint64 = reader.header.descriptors[componentPaths-1].offset
+	var blockNumber uint64 = offset / readBlockSize
+	var within int = int(offset % readBlockSize)
+	var block *readBlock = &reader.cache.slots[blockNumber%readCacheSlots]
+	block.mu.Lock()
+	var saved uint64 = binary.LittleEndian.Uint64(block.data[within : within+8])
+	binary.LittleEndian.PutUint64(block.data[within:within+8], ^uint64(0))
+	block.mu.Unlock()
+	var budget ReadBudget = NewReadBudget(context.Background(), 1<<20, maximumStoredString)
+	var row catalog.Row = catalog.Row{}
+	row, exists, err = reader.RowBounded(0, &budget)
+	if err == nil || exists || row != (catalog.Row{}) {
+		t.Fatal("corrupt path returned row", row, err)
+	}
+	var terminal error = err
+	var used uint64 = budget.UsedBytes()
+	block.mu.Lock()
+	binary.LittleEndian.PutUint64(block.data[within:within+8], saved)
+	block.mu.Unlock()
+	row, exists, err = reader.RowBounded(0, &budget)
+	if err != terminal || exists || row != (catalog.Row{}) || budget.UsedBytes() != used {
+		t.Fatal("decode failure was not terminal", err)
+	}
+	row, exists, err = reader.Row(0)
+	if err != nil || !exists || row != expected {
+		t.Fatal("private failure affected legacy consumer", err)
+	}
+}
