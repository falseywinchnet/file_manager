+// Generated block source intentionally overwrites bytes before reporting an
+// injected replacement failure. No filesystem/source data participates.
+type budgetBlockSource struct {
+	calls  int
+	fail   bool
+	cancel context.CancelFunc
+}
+
+func (s *budgetBlockSource) ReadAt(output []byte, offset int64) (int, error) {
+	s.calls++
+	var fill byte = 17
+	if offset != 0 {
+		fill = 29
+	}
+	var index int = 0
+	for index = 0; index < len(output); index++ {
+		output[index] = fill
+	}
+	if s.cancel != nil {
+		s.cancel()
+	}
+	if s.fail {
+		return len(output) / 2, io.ErrUnexpectedEOF
+	}
+	return len(output), nil
+}
+
+func TestReadBudgetBlockCancellationAndFailedReplacement(t *testing.T) {
+	var input budgetBlockSource = budgetBlockSource{}
+	var reader Reader = Reader{cache: readCache{file: &input, fileSize: ReadCacheLimit + readBlockSize}}
+	var output [1]byte = [1]byte{}
+	var err error = reader.cache.readAt(output[:], 0)
+	if err != nil || output[0] != 17 {
+		t.Fatal("initial block", err)
+	}
+	input.fail = true
+	err = reader.cache.readAt(output[:], ReadCacheLimit)
+	if !errors.Is(err, io.ErrUnexpectedEOF) || reader.cache.slots[0].valid {
+		t.Fatal("failed replacement left slot valid", err)
+	}
+	input.fail = false
+	err = reader.cache.readAt(output[:], 0)
+	if err != nil || output[0] != 17 || input.calls != 3 {
+		t.Fatal("failed replacement poisoned old block", err, output, input.calls)
+	}
+
+	var ctx context.Context = nil
+	var cancel context.CancelFunc = nil
+	ctx, cancel = context.WithCancel(context.Background())
+	defer cancel()
+	var cancelling budgetBlockSource = budgetBlockSource{cancel: cancel}
+	var cold Reader = Reader{cache: readCache{file: &cancelling, fileSize: 3 * readBlockSize}}
+	var budget ReadBudget = NewReadBudget(ctx, 2*readBlockSize, maximumStoredString)
+	var access readerAccess = readerAccess{Reader: &cold, budget: &budget}
+	var large []byte = make([]byte, 2*readBlockSize)
+	err = access.readAt(large, 0)
+	if !errors.Is(err, context.Canceled) || cancelling.calls != 1 || budget.UsedBytes() != 2*readBlockSize || cold.cache.slots[0].valid {
+		t.Fatal("multi-block call continued after native cancellation", err, cancelling.calls, budget)
+	}
+}
