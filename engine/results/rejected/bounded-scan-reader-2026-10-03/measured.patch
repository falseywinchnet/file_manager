+		}
+		t.Logf("query=%q scope=%q descendants=%v matches=%d pages=%d examined=%d read_bytes=%d digest=%x", queries[index].Text, queries[index].Scope, queries[index].Descendants, actual.Matches, actual.Pages, actual.Examined, bytes, actual.Digest)
+	}
