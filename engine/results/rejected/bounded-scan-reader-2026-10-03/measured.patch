+func TestBoundedScanCompleteRecordsAndAccounting(t *testing.T) {
+	var reader *Reader = boundedScanFixture(t, workload.CorrectnessV1())
+	defer reader.Close()
+	var scan *BoundedScanCandidate = boundedScanNew(t, reader, context.Background(), math.MaxUint64, maximumStoredString)
+	var used uint64 = 0
+	var ordinal uint32 = 0
+	for ordinal = 0; uint64(ordinal) < reader.Len(); ordinal++ {
+		var wantRow catalog.Row = catalog.Row{}
+		var wantRecord catalog.Record = catalog.Record{}
+		var row catalog.Row = catalog.Row{}
+		var record catalog.Record = catalog.Record{}
+		var exists bool = false
+		var err error = nil
+		wantRow, exists, err = reader.Row(ordinal)
+		if err != nil || !exists {
+			t.Fatal("legacy row", err)
+		}
+		wantRecord, exists, err = reader.Record(ordinal)
+		if err != nil || !exists {
+			t.Fatal("legacy record", err)
+		}
+		row, exists, err = scan.Row(ordinal)
+		if err != nil || !exists || row != wantRow {
+			t.Fatal("complete row mismatch", ordinal, err)
+		}
+		record, exists, err = scan.Record(ordinal)
+		if err != nil || !exists || record != wantRecord {
+			t.Fatal("complete record mismatch", ordinal, err)
+		}
+		var storedPathBytes uint64 = uint64(len(filepath.ToSlash(wantRow.RelativePath)))
+		var recordBytes uint64 = bindingRecordSize + objectRecordSize + pathRecordSize + uint64(len(wantRow.Name)) + storedPathBytes
+		used += 2*recordBytes + objectRecordSize
+		if scan.ReadBytes() != used {
+			t.Fatal("logical count mismatch", scan.ReadBytes(), used)
+		}
+		// Scratch now holds the last path; previously returned name stays owned.
+		if row != wantRow || record != wantRecord {
+			t.Fatal("scratch escaped")
+		}
+	}
+	var absent catalog.Record = catalog.Record{}
+	var exists bool = true
+	var err error = nil
+	absent, exists, err = scan.Record(uint32(reader.Len()))
+	if err != nil || exists || absent != (catalog.Record{}) || scan.ReadBytes() != used {
+		t.Fatal("EOF changed state")
+	}
+	var absentRow catalog.Row = catalog.Row{}
+	absentRow, exists, err = scan.Row(math.MaxUint32)
+	if err != nil || exists || absentRow != (catalog.Row{}) || scan.ReadBytes() != used {
+		t.Fatal("row EOF changed state")
+	}
+}
