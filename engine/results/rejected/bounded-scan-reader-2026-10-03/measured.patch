+func TestBoundedScanExactBudgetsAndStickyFailure(t *testing.T) {
+	var reader *Reader = boundedScanFixture(t, workload.CorrectnessV1())
+	defer reader.Close()
+	var want catalog.Row = catalog.Row{}
+	var exists bool = false
+	var err error = nil
+	want, exists, err = reader.Row(0)
+	if err != nil || !exists {
+		t.Fatal(err)
+	}
+	var nameBytes uint64 = uint64(len(want.Name))
+	var pathBytes uint64 = uint64(len(filepath.ToSlash(want.RelativePath)))
+	var exact uint64 = bindingRecordSize + 2*objectRecordSize + pathRecordSize + nameBytes + pathBytes
+	var scan *BoundedScanCandidate = boundedScanNew(t, reader, context.Background(), exact, maximumStoredString)
+	var row catalog.Row = catalog.Row{}
+	row, exists, err = scan.Row(0)
+	if err != nil || !exists || row != want || scan.ReadBytes() != exact {
+		t.Fatal("exact budget failed", err)
+	}
+	row, exists, err = scan.Row(0)
+	if !errors.Is(err, ErrScanReadBudget) || exists || row != (catalog.Row{}) || scan.ReadBytes() != exact {
+		t.Fatal("cache hit was not charged")
+	}
+	row, exists, err = scan.Row(math.MaxUint32)
+	if !errors.Is(err, ErrScanReadBudget) || exists || row != (catalog.Row{}) {
+		t.Fatal("EOF erased sticky error")
+	}
+	// Every insufficient budget must fail without publishing any part of a row.
+	var limit uint64 = 0
+	for limit = 0; limit < exact; limit++ {
+		scan = boundedScanNew(t, reader, context.Background(), limit, maximumStoredString)
+		row, exists, err = scan.Row(0)
+		if !errors.Is(err, ErrScanReadBudget) || exists || row != (catalog.Row{}) || scan.ReadBytes() > limit {
+			t.Fatal("short row budget", limit, err)
+		}
+		var before uint64 = scan.ReadBytes()
+		var record catalog.Record = catalog.Record{}
+		record, exists, err = scan.Record(0)
+		if !errors.Is(err, ErrScanReadBudget) || exists || record != (catalog.Record{}) || scan.ReadBytes() != before {
+			t.Fatal("sticky record failure")
+		}
+	}
+	var exactRecord uint64 = exact - objectRecordSize
+	scan = boundedScanNew(t, reader, context.Background(), exactRecord, maximumStoredString)
+	var record catalog.Record = catalog.Record{}
+	record, exists, err = scan.Record(0)
+	if err != nil || !exists || record.Name != want.Name || scan.ReadBytes() != exactRecord {
+		t.Fatal("exact record budget")
+	}
+	scan = boundedScanNew(t, reader, context.Background(), exact, nameBytes-1)
+	row, exists, err = scan.Row(0)
+	if !errors.Is(err, ErrScanStringBudget) || exists || row != (catalog.Row{}) || cap(scan.scratch) != 0 || scan.ReadBytes() != bindingRecordSize+2*objectRecordSize {
+		t.Fatal("string refusal allocated or charged", err)
+	}
+	scan = boundedScanNew(t, reader, context.Background(), bindingRecordSize+2*objectRecordSize+nameBytes-1, maximumStoredString)
+	row, exists, err = scan.Row(0)
+	if !errors.Is(err, ErrScanReadBudget) || exists || row != (catalog.Row{}) || cap(scan.scratch) != 0 {
+		t.Fatal("read refusal allocated string")
+	}
+}
