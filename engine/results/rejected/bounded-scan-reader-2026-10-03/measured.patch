+func TestBoundedScanOwnerAndCancellation(t *testing.T) {
+	var reader *Reader = boundedScanFixture(t, workload.CorrectnessV1())
+	defer reader.Close()
+	var unchecked *Reader = nil
+	var err error = nil
+	unchecked, err = Open(reader.file.Name(), reader.Root())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unchecked.Close()
+	var scan *BoundedScanCandidate = nil
+	scan, err = NewBoundedScanCandidate(unchecked, context.Background(), 1000, 1000)
+	if err == nil || scan != nil {
+		t.Fatal("unchecked reader accepted")
+	}
+	var ctx context.Context = nil
+	var cancel context.CancelFunc = nil
+	ctx, cancel = context.WithCancel(context.Background())
+	defer cancel()
+	scan = boundedScanNew(t, reader, ctx, 10000, 1000)
+	var independent *BoundedScanCandidate = boundedScanNew(t, reader, context.Background(), 10000, 1000)
+	var saved catalog.Record = catalog.Record{}
+	var exists bool = false
+	saved, exists, err = scan.Record(0)
+	if err != nil || !exists {
+		t.Fatal(err)
+	}
+	var before uint64 = scan.ReadBytes()
+	cancel()
+	var record catalog.Record = catalog.Record{}
+	record, exists, err = scan.Record(1)
+	if !errors.Is(err, context.Canceled) || exists || record != (catalog.Record{}) || scan.ReadBytes() != before {
+		t.Fatal("cancellation changed result/budget")
+	}
+	record, exists, err = independent.Record(0)
+	if err != nil || !exists || record != saved {
+		t.Fatal("query state leaked into reader")
+	}
+	err = reader.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	record, exists, err = independent.Record(0)
+	if err == nil || exists || record != (catalog.Record{}) {
+		t.Fatal("closed owner served warm cache", err)
+	}
+	if saved.Name == "" || saved.Path == "" {
+		t.Fatal("returned ownership lost")
+	}
+	scan, err = NewBoundedScanCandidate(reader, context.Background(), 1000, 1000)
+	if err == nil || scan != nil {
+		t.Fatal("closed reader accepted", err)
+	}
+}
+
+// A named context wrapper schedules real context cancellation at a selected
+// read checkpoint. It changes no file bytes and injects no I/O/cache failure.
+type scanCancelCheckpoint struct {
+	context.Context
+	cancel context.CancelFunc
+	calls  int
+	at     int
+}
+
+func (c *scanCancelCheckpoint) Err() error {
+	c.calls++
+	if c.calls == c.at {
+		c.cancel()
+	}
+	var err error = c.Context.Err()
+	return err
+}
