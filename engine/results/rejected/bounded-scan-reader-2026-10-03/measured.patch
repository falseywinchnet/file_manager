+func boundedScanFixture(t *testing.T, corpus workload.Corpus) *Reader {
+	t.Helper()
+	var root api.RootSpec = api.RootSpec{ID: "bounded-fixture", Path: filepath.Join(t.TempDir(), "logical-source")}
+	var shard *catalog.Shard = nil
+	var err error = nil
+	shard, err = corpus.ReferenceShard(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var path string = filepath.Join(t.TempDir(), "fixture.seg")
+	var metadata Metadata = Metadata{}
+	metadata, err = Write(path, 7, shard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reader *Reader = nil
+	reader, err = Open(path, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = reader.Check(metadata.SegmentDigest)
+	if err != nil {
+		reader.Close()
+		t.Fatal(err)
+	}
+	return reader
+}
+
+func boundedScanNew(t *testing.T, reader *Reader, ctx context.Context, bytes, stringBytes uint64) *BoundedScanCandidate {
+	t.Helper()
+	var scan *BoundedScanCandidate = nil
+	var err error = nil
+	scan, err = NewBoundedScanCandidate(reader, ctx, bytes, stringBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return scan
+}
